# Copy this file to .env and fill in values. Never commit .env.
#   cp .env.example .env && chmod 600 .env
#
# v2.0 起只有网易云一个在线音源，且只使用扫码登录的那个私人账号的权益。

FNMUSIC_HOME=

# --- 网易云音源（musicbox: https://github.com/darknessomi/musicbox） ---
FNMUSIC_NETEASE_ENABLED=true
FNMUSIC_MUSICBOX_URL=http://127.0.0.1:8770
# 音源服务监听地址。默认只绑回环：它的接口全部无鉴权（含发起扫码登录），
# 绑 0.0.0.0 等于同网段任何人都能扫自己的号顶掉你的网易云登录。
# 仅当你确实要在别的设备上用浏览器打开 http://<NAS_IP>:8770/api/v1/auth/login/qr.png
# 时才改成 0.0.0.0，并自行做好防火墙/内网隔离。
FNMUSIC_MUSICBOX_BIND=127.0.0.1
# 音质：lossless / exhigh / higher / standard（账号无对应权益时自动回退）
FNMUSIC_NETEASE_QUALITY=lossless
# 单次搜索向网易云请求的曲目数上限
FNMUSIC_NETEASE_SEARCH_LIMIT=50
# 搜索结果并入飞牛列表的条数上限
FNMUSIC_ONLINE_LIMIT=30
# 首屏等待预算（秒）；超时后再等 FNMUSIC_LATE_PAGE_WAIT_S 的兜底预算
FNMUSIC_NETEASE_WAIT_S=3.0
FNMUSIC_LATE_PAGE_WAIT_S=5.0
FNMUSIC_SEARCH_TIMEOUT=15
# 搜索结果缓存有效期（默认 7 天）
FNMUSIC_SEARCH_CACHE_TTL=604800

# --- 登录态与降级 ---
# 未扫码登录（或 cookie 过期）时：true=降级为只播免费曲目，false=完全不提供在线播放
FNMUSIC_FREE_ONLY_ON_LOGOUT=true
# 登录态缓存 TTL 与后台巡检间隔（秒）
FNMUSIC_LOGIN_STATE_TTL=300
FNMUSIC_LOGIN_CHECK_INTERVAL=3600
# VIP 到期前几天开始 PushPlus 提醒
FNMUSIC_VIP_WARN_DAYS=7

# --- 网易云官方「每日推荐」歌单（需要登录私人账号） ---
FNMUSIC_DAILY_ENABLED=true
FNMUSIC_DAILY_LIMIT=20

# --- PushPlus 推送提醒（掉线 / VIP 临期） ---
# token 到 https://www.pushplus.plus 个人中心获取；留空则不发送任何推送
FNMUSIC_PUSHPLUS_ENABLED=true
FNMUSIC_PUSHPLUS_TOKEN=
# 群组编码，留空只发给自己
FNMUSIC_PUSHPLUS_TOPIC=
# 模板：markdown / html / txt / json
FNMUSIC_PUSHPLUS_TEMPLATE=markdown
FNMUSIC_PUSHPLUS_URL=https://www.pushplus.plus/send

# --- 运行形态 ---
FNMUSIC_MODE=docker

# Docker 构建源（docker 模式）
# 基础镜像：留空时安装自动探测（国内镜像优先直连绕开 daemon 加速器，官方源兜底）并缓存到此键；
# 也可手动指定可用镜像引用，例如 docker.m.daocloud.io/library/python:3.13-slim
FNMUSIC_BASE_IMAGE=
# 容器内 pip 源（默认清华，与宿主机模式一致）
FNMUSIC_PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
# 可选：自动探测时的国内镜像候选列表（空格分隔，按序尝试）
FNMUSIC_DOCKER_MIRRORS=docker.1ms.run docker.m.daocloud.io docker.1panel.live hub.rat.dev
