# Copy this file to .env and fill in values. Never commit .env.
#   cp .env.example .env && chmod 600 .env
#
# v2.0 起只有网易云一个在线音源，且只使用扫码登录的那个私人账号的权益。

FNMUSIC_HOME=

# --- 网易云音源（musicbox: https://github.com/darknessomi/musicbox） ---
FNMUSIC_NETEASE_ENABLED=true
FNMUSIC_MUSICBOX_URL=http://127.0.0.1:8770
# 音源服务监听地址。默认只绑回环：它的接口全部无鉴权（含发起扫码登录），
# 绑 0.0.0.0 等于同网段任何人都能扫自己的号顶掉你的网易云登录。
# 仅当你确实要在别的设备上用浏览器打开 http://<NAS_IP>:8770/api/v1/auth/login/qr.png
# 时才改成 0.0.0.0，并自行做好防火墙/内网隔离。
FNMUSIC_MUSICBOX_BIND=127.0.0.1
# 音质：lossless / exhigh / higher / standard（账号无对应权益时自动回退）
FNMUSIC_NETEASE_QUALITY=lossless
# 单次搜索向网易云请求的曲目数上限
FNMUSIC_NETEASE_SEARCH_LIMIT=50
# 搜索结果并入飞牛列表的条数上限
FNMUSIC_ONLINE_LIMIT=30
# 首屏等待预算（秒）；超时后再等 FNMUSIC_LATE_PAGE_WAIT_S 的兜底预算
FNMUSIC_NETEASE_WAIT_S=3.0
FNMUSIC_LATE_PAGE_WAIT_S=5.0
FNMUSIC_SEARCH_TIMEOUT=15
# 搜索结果缓存有效期（默认 7 天）
FNMUSIC_SEARCH_CACHE_TTL=604800
# 搜索结果【为空】时改用这个短 TTL（秒）。上游一次抖动就可能返回空结果，
# 若按 7 天缓存，该关键词会在整整一周内只返回本地歌曲，即使上游早已恢复。
FNMUSIC_SEARCH_EMPTY_TTL=60
# musicbox 侧登录态缓存 TTL（秒）。可播性过滤每轮都要查一次账号信息，
# 缓存掉能省一次到网易云的往返，明显缩短搜索首屏耗时。
FNMUSIC_LOGIN_CACHE_TTL=300

# --- 登录态与降级 ---
# 未扫码登录（或 cookie 过期）时：true=降级为只播免费曲目，false=完全不提供在线播放
FNMUSIC_FREE_ONLY_ON_LOGOUT=true
# 登录态缓存 TTL 与后台巡检间隔（秒）
FNMUSIC_LOGIN_STATE_TTL=300
FNMUSIC_LOGIN_CHECK_INTERVAL=3600
# VIP 到期前几天开始 PushPlus 提醒
FNMUSIC_VIP_WARN_DAYS=7

# --- 网易云官方「每日推荐」歌单（需要登录私人账号） ---
FNMUSIC_DAILY_ENABLED=true
FNMUSIC_DAILY_LIMIT=20

# --- 更多口径歌单 / 账户歌单 ---
# 注入哪些口径：mine=我的歌单(自建+收藏) nrec=推荐歌单 toplist=排行榜
# category=分类歌单 newalbum=新碟上架 fm=私人FM（逗号分隔）
FNMUSIC_NETEASE_CHANNELS=mine,toplist,category
# 各口径（大类）在飞牛歌单列表里的展示顺序；没列出的排最后。
# daily=每日推荐（由 FNMUSIC_DAILY_ENABLED 单独控制是否出现）
FNMUSIC_NETEASE_CHANNEL_ORDER=daily,mine,nrec,toplist,category,newalbum,fm
# 手动歌单顺序（v2.5）：管理页「歌单顺序」卡片逐个排好的 token 列表
# （daily 或 online:playlist:... 的 guid）。留空 = 按上面的大类顺序排。
# 代理实时读取本文件，改完保存即生效，无需重启。
FNMUSIC_NETEASE_PLAYLIST_ORDER=
# 每个口径最多注入几个歌单
FNMUSIC_NETEASE_CHANNEL_LIMIT=8
# 分类歌单的分类名
FNMUSIC_NETEASE_CATEGORY=华语
# 点开歌单时最多解析多少首
FNMUSIC_PLAYLIST_TRACK_LIMIT=300
# 歌单曲目缓存（v2.6）：缓存视为新鲜的时长（秒，默认 6 小时）。
# 期内点开直接读本地；超期先返回旧值、后台自动刷新。
FNMUSIC_PLAYLIST_TRACK_CACHE_TTL=21600
# 每日定时后台刷新全部歌单曲目缓存的时间（HH:MM，留空关闭）
FNMUSIC_PLAYLIST_REFRESH_AT=04:30
# 口径清单短缓存（v2.7）：歌单列表页在 TTL 内零上游往返（榜单打开提速），
# 过期后先返回旧值并后台刷新。0 = 每次实拉。
FNMUSIC_CHANNEL_LIST_CACHE_TTL=300

# --- 稳定性与播放提速（v2.7） ---
# 看门狗轮询间隔（秒）：代理进程死亡或 socket 接管丢失（官方后端重启会重绑
# /var/run/trim_music.socket）时自动恢复；0 = 关闭。
FNMUSIC_WATCHDOG_INTERVAL_S=30
# 播放直链短缓存（秒）：网易云 CDN 直链约有 20 分钟有效期，复用可省去
# 重复取链的跨洋往返（切歌/seek/重播提速）；0 = 关闭。
FNMUSIC_URL_CACHE_TTL=600

# --- 远程访问识别与本地曲库优先（v2.8） ---
# 飞牛客户端从不发送网络类型标识，「按网络」策略里的流量档从未触发过——
# 移动数据远程访问时也一直按 WiFi 档发 Hi-Res 母带，窄管道起步缓冲好几秒。
# 现在从 X-Forwarded-For / X-Real-IP 读真实客户端 IP：公网 IP = 远程访问，
# 默认视同流量场景走省流档；false = 关闭（远程也按 WiFi 档）。
# 诊断页「客户端 IP 线索」可看到证据；若 nginx 未透传这些头则识别不可用。
FNMUSIC_REMOTE_AS_CELLULAR=true
# 本地曲库优先：播放网易云歌单曲目时先在飞牛 music.db 里找同名歌曲
# （标题归一化全等 + 主艺术家匹配），命中且音质类与当前策略一致时直接读
# 本地文件——零外网、起步最快。策略要 lossless 而本地是无损 → 用本地；
# 策略要 exhigh（省流量）而本地是 Hi-Res → 不用本地，仍按策略要 320k；
# 网易云取链失败时本地匹配（不论档位）作最后兜底。
FNMUSIC_LOCAL_FIRST=true
# 本地曲库索引的内存缓存时长（秒），过期后重新扫描 music.db
FNMUSIC_LOCAL_INDEX_TTL=300
# 封面缩图边长（像素）：网易云 CDN 原生支持 ?param=NyN 服务端缩图。
# 原图几百 KB～1MB，一个歌单列表首屏几十 MB 正是移动网络卡顿的主力；
# 300px 缩图约 20~50KB。0 = 不压缩（拿原图）。
FNMUSIC_COVER_RESIZE_PX=300

# --- 播放链路转发（本地曲目 stream / HLS / 转码会话） ---
# 官方后端处理转码要等 ffmpeg 产出首分片，读超时给足（秒）
FNMUSIC_PLAYBACK_FORWARD_TIMEOUT_S=300

# --- PushPlus 推送提醒（掉线 / VIP 临期） ---
# token 到 https://www.pushplus.plus 个人中心获取；留空则不发送任何推送
FNMUSIC_PUSHPLUS_ENABLED=true
FNMUSIC_PUSHPLUS_TOKEN=
# 群组编码，留空只发给自己
FNMUSIC_PUSHPLUS_TOPIC=
# 模板：markdown / html / txt / json
FNMUSIC_PUSHPLUS_TEMPLATE=markdown
FNMUSIC_PUSHPLUS_URL=https://www.pushplus.plus/send

# --- 日志保留策略 ---
# 单个日志文件超过该 MB 数就地截断、只保留最近一半（对 O_APPEND 写入端安全）；
# 超过保留天数的备份日志直接删除、超期活跃日志清空。0 表示关闭对应策略。
FNMUSIC_LOG_MAX_MB=10
FNMUSIC_LOG_MAX_DAYS=30
# 管理页面进程的日志清理巡检间隔（秒）
FNMUSIC_LOG_SCAN_INTERVAL=3600

# --- 运行形态 ---
FNMUSIC_MODE=docker

# Docker 构建源（docker 模式）
# 基础镜像：留空时安装自动探测（国内镜像优先直连绕开 daemon 加速器，官方源兜底）并缓存到此键；
# 也可手动指定可用镜像引用，例如 docker.m.daocloud.io/library/python:3.13-slim
FNMUSIC_BASE_IMAGE=
# 容器内 pip 源（默认清华，与宿主机模式一致）
FNMUSIC_PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
# 可选：自动探测时的国内镜像候选列表（空格分隔，按序尝试）
FNMUSIC_DOCKER_MIRRORS=docker.1ms.run docker.m.daocloud.io docker.1panel.live hub.rat.dev
