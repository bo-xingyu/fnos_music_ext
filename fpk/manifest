ctl_stop              = true
checkport             = false
disable_authorization_path = true

changelog             = v2.8.0：移动数据远程访问提速 + 本地曲库优先播放。①远程访问识别：飞牛客户端从不发送网络类型标识，「按网络」策略的流量档从未触发过——移动数据远程访问也一直按 WiFi 档发 Hi-Res 母带，窄管道起步 7~8 秒。现从 X-Forwarded-For/X-Real-IP 识别公网客户端 IP，远程访问默认按流量场景走省流档（FNMUSIC_REMOTE_AS_CELLULAR 可关），证据在诊断页「客户端 IP 线索」可见。②本地曲库优先：播放网易云歌单曲目先在飞牛 music.db 里找同名歌曲（标题归一化全等+主艺术家匹配），命中且音质类与策略一致时直接读本地文件——零外网、起步最快；策略要 exhigh 而本地只有 Hi-Res 时不吃本地母带（按策略降码率），网易云取链失败时本地匹配作最后兜底（FNMUSIC_LOCAL_FIRST 可关）。③封面字节磁盘缓存：同一封面 URL 一生只从网易云 CDN 抓一次，歌单列表渲染不再被重复 CDN 往返拖慢。④播放起步与歌单打开耗时留证日志（play-start / playlist tracks slow open），真机可量化。v2.7.1：修复歌单缓存计数显示矛盾。v2.7.0：看门狗自愈异常退出+直链短缓存+口径清单缓存+tee内存背压。v2.6.0：歌单打开提速。v2.5.0：管理页歌单顺序。v2.4.x：多项修复。v2.3.0：音质档位跟随飞牛。v2.2.x：更多口径歌单+收藏下载。v2.1.x：桌面管理页面。v2.0.0：网易云单源化。

desktop_uidir         = ui
desktop_applaunchname = fnmusicext.main
