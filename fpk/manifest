appname               = fnmusicext
version               = 2.4.0
display_name          = 飞牛音乐扩展（网易云）
desc                  = 为飞牛音乐（trim.music）提供网易云在线音源扩展：在官方 App 搜索框内直接搜播网易云曲库，补齐 LRC 歌词与高清封面，边播边存无感离线，多用户隔离红心收藏，并注入网易云官方「每日推荐」歌单。<br/><br/>安装后飞牛桌面会出现「飞牛音乐扩展」图标，打开即可在网页里扫码登录网易云、配置全部选项、查看运行日志，全程无需 SSH。<br/><br/>采用无侵入 Unix Domain Socket 接管，完全不修改飞牛官方程序、nginx 配置与数据库。在线音源只使用你扫码登录的那一个私人网易云账号的权益；未登录时自动降级为只播免费曲目，并可通过 PushPlus 推送登录失效与 VIP 临期提醒。
source                = thirdparty
platform              = all

maintainer            = gzywd
maintainer_url        = https://github.com/gzywd/fnos_music_ext
distributor           = gzywd
distributor_url       = https://github.com/gzywd/fnos_music_ext

os_min_version        = 1.1.3100

install_dep_apps      = python312

ctl_stop              = true
checkport             = false
disable_authorization_path = true

changelog             = v2.4.0：修复五个真机反馈问题。① 升级/保存设置后配置全部丢失——setup.sh 每次整表重写 .env，改为三源合并（向导/既有值/默认），升级一律保留用户设置，重装还能从快照恢复全部旧值与自定义键。② 我的歌单（自建+收藏）不同步——两处漏改的函数重命名让 NameError 被吞：音源服务解析不了 uid、代理永远认为未登录，双双修复。③ 歌单顺序不固定——所有注入歌单时间戳相同撞上客户端非稳定排序，改为互不相同的递减时间戳，并新增「歌单大类顺序」设置可自定义各大类先后。④ 管理页保存配置后应用闪退——重启窗口内 status 如实报"未运行"导致飞牛桌面回收窗口，新增重启标记保持 running。⑤ 开转码后本地音乐播放不了——转发剥掉了 Host 头（官方后端按它拼 m3u8 绝对地址）且 30s 读超时不够 ffmpeg 出首片，改为透传 Host + 播放链路 300s 超时。v2.3.0：按飞牛音质偏好（WiFi/流量 × 原始/标准）动态决定网易云音质档位。v2.2.1：修复管理页保存收藏归档目录必然失败。v2.2.0：更多口径推荐歌单+账户歌单+收藏自动下载+红心双向同步。v2.1.x：桌面管理页面、播放热路径进程内直取、试听误判修复等。v2.0.0：网易云单源化。

desktop_uidir         = ui
desktop_applaunchname = fnmusicext.main
