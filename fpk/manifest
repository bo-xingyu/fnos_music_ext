appname               = fnmusicext
version               = 2.7.0
display_name          = 飞牛音乐扩展（网易云）
desc                  = 为飞牛音乐（trim.music）提供网易云在线音源扩展：在官方 App 搜索框内直接搜播网易云曲库，补齐 LRC 歌词与高清封面，边播边存无感离线，多用户隔离红心收藏，并注入网易云官方「每日推荐」歌单。<br/><br/>安装后飞牛桌面会出现「飞牛音乐扩展」图标，打开即可在网页里扫码登录网易云、配置全部选项、查看运行日志，全程无需 SSH。<br/><br/>采用无侵入 Unix Domain Socket 接管，完全不修改飞牛官方程序、nginx 配置与数据库。在线音源只使用你扫码登录的那一个私人网易云账号的权益；未登录时自动降级为只播免费曲目，并可通过 PushPlus 推送登录失效与 VIP 临期提醒。
source                = thirdparty
platform              = all

maintainer            = gzywd
maintainer_url        = https://github.com/gzywd/fnos_music_ext
distributor           = gzywd
distributor_url       = https://github.com/gzywd/fnos_music_ext

os_min_version        = 1.1.3100

install_dep_apps      = python312

ctl_stop              = true
checkport             = false
disable_authorization_path = true

changelog             = v2.7.0：稳定性与打开提速——①看门狗自愈：官方后端重启重绑 socket 导致的「应用异常退出」（代理还活着但接管丢失）或进程意外死亡时，30 秒内自动恢复接管；主动停机有 stopped.flag 保护，绝不把用户停掉的应用拉起来（FNMUSIC_WATCHDOG_INTERVAL_S 可调/可关）。②播放直链短缓存（默认 10 分钟）：切歌/重播不再重复取链，缓存链失效自动重取重试。③歌单/榜单打开提速：曲目自带封面不再多打一次补齐往返；口径清单 5 分钟缓存+过期后台刷新，列表页打开稳定秒级。④内存安全：在线播放 tee 缓冲加背压上限（约 4MB），客户端断开转只写盘完成缓存，杜绝慢客户端整首歌堆内存。v2.6.0：歌单打开提速——曲目缓存+先读缓存后台刷新+每日定时刷新+自动预热。v2.5.0：管理页「歌单顺序」手动排序。v2.4.1：歌单顺序升序修正+本地转码透传。v2.4.0：设置持久化/保存闪退等修复。v2.3.0：音质档位跟随飞牛。v2.2.x：更多口径歌单+收藏下载+红心同步。v2.1.x：桌面管理页面。v2.0.0：网易云单源化。

desktop_uidir         = ui
desktop_applaunchname = fnmusicext.main
