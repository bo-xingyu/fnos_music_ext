appname               = fnmusicext
version               = 2.8.1
display_name          = 飞牛音乐扩展（网易云）
desc                  = 为飞牛音乐（trim.music）提供网易云在线音源扩展：在官方 App 搜索框内直接搜播网易云曲库，补齐 LRC 歌词与高清封面，边播边存无感离线，多用户隔离红心收藏，并注入网易云官方「每日推荐」歌单。<br/><br/>安装后飞牛桌面会出现「飞牛音乐扩展」图标，打开即可在网页里扫码登录网易云、配置全部选项、查看运行日志，全程无需 SSH。<br/><br/>采用无侵入 Unix Domain Socket 接管，完全不修改飞牛官方程序、nginx 配置与数据库。在线音源只使用你扫码登录的那一个私人网易云账号的权益；未登录时自动降级为只播免费曲目，并可通过 PushPlus 推送登录失效与 VIP 临期提醒。
source                = thirdparty
platform              = all

maintainer            = gzywd
maintainer_url        = https://github.com/gzywd/fnos_music_ext
distributor           = gzywd
distributor_url       = https://github.com/gzywd/fnos_music_ext

os_min_version        = 1.1.3100

install_dep_apps      = python312

ctl_stop              = true
checkport             = false
disable_authorization_path = true

changelog             = v2.8.1：移动网络歌单卡顿修复 + 本地曲库优先不生效修复。①封面缩图：网易云原图几百 KB~1MB，一个歌单列表首屏几十 MB 正是移动网络卡顿主力；现走网易云 CDN 服务端缩图（?param=300y300，约 20~50KB），客户端带 size 参数时优先采用，缩图失败回落原图（FNMUSIC_COVER_RESIZE_PX 可调，0=不压缩）。②music.db 自动定位：真机诊断显示默认路径不存在（飞牛数据在 /vol*/@appdata），导致「跟随飞牛」读不到偏好、本地曲库优先建立在空库上永不命中；现自动探测常见布局，本地曲库索引就绪/为空均有日志留证。v2.8.0：远程访问识别走省流档+本地曲库优先+封面磁盘缓存+耗时留证。v2.7.1：歌单缓存计数修复。v2.7.0：看门狗自愈异常退出+直链短缓存+口径清单缓存。v2.6.0：歌单打开提速。v2.5.0：管理页歌单顺序。v2.3.0：音质档位跟随飞牛。v2.2.x：更多口径歌单+收藏下载。v2.0.0：网易云单源化。

desktop_uidir         = ui
desktop_applaunchname = fnmusicext.main
