appname               = fnmusicext
version               = 2.9.4
display_name          = 飞牛音乐扩展（网易云）
desc                  = 为飞牛音乐（trim.music）提供网易云在线音源扩展：在官方 App 搜索框内直接搜播网易云曲库，补齐 LRC 歌词与高清封面，边播边存无感离线，多用户隔离红心收藏，并注入网易云官方「每日推荐」歌单。<br/><br/>安装后飞牛桌面会出现「飞牛音乐扩展」图标，打开即可在网页里扫码登录网易云、配置全部选项、查看运行日志，全程无需 SSH。<br/><br/>采用无侵入 Unix Domain Socket 接管，完全不修改飞牛官方程序、nginx 配置与数据库。在线音源只使用你扫码登录的那一个私人网易云账号的权益；未登录时自动降级为只播免费曲目，并可通过 PushPlus 推送登录失效与 VIP 临期提醒。
source                = thirdparty
platform              = all

maintainer            = gzywd
maintainer_url        = https://github.com/gzywd/fnos_music_ext
distributor           = gzywd
distributor_url       = https://github.com/gzywd/fnos_music_ext

os_min_version        = 1.1.3100

install_dep_apps      = python312

ctl_stop              = true
checkport             = false
disable_authorization_path = false
micro_app             = true

changelog             = v2.9.4：按飞牛开发规范改用「应用授权目录」访问本地曲库，不再靠 root 硬读。① 应用包声明 api-scope: trim.file.sharedAccess，manifest 打开授权入口（disable_authorization_path=false）并声明 micro_app=true，管理员在「应用设置 → 授权目录」即可合规授权；② 新增 trimgw 模块，通过 Unix Socket /var/run/trim_open_gateway_apiscope.socket 调 trim.file.getSharedAccessibleFolders 查询已授权目录（token 每次从 TRIM_API_TOKEN 现读、绝不落盘），兼容旧版 TRIM_DATA_SHARE_PATHS 环境变量；③ 曲库目录定位优先级改为「管理页配置 → 已授权目录 → music.db → 缓存目录」，未授权时明确告警并给出指引（可用 FNMUSIC_STRICT_AUTHORIZATION=true 强制只扫已授权目录）；④ 管理页新增「飞牛授权目录」卡片，可一键唤起飞牛目录选择器，SDK 不可用时降级为引导+刷新状态；⑤ 诊断页新增授权状态区块（网关/token/已授权目录/当前曲库是否被覆盖）。同时修复本地每日推荐歌单封面 404：改为现生成零依赖 PNG 唱片封面（按尺寸内存缓存），避免个别客户端因歌单封面 404 而整条不渲染。
desktop_uidir         = ui
desktop_applaunchname = fnmusicext.main
