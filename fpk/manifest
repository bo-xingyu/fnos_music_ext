appname               = fnmusicext
version               = 2.9.6
display_name          = 飞牛音乐扩展（网易云）
desc                  = 为飞牛音乐（trim.music）提供网易云在线音源扩展：在官方 App 搜索框内直接搜播网易云曲库，补齐 LRC 歌词与高清封面，边播边存无感离线，多用户隔离红心收藏，并注入网易云官方「每日推荐」歌单。<br/><br/>安装后飞牛桌面会出现「飞牛音乐扩展」图标，打开即可在网页里扫码登录网易云、配置全部选项、查看运行日志，全程无需 SSH。<br/><br/>采用无侵入 Unix Domain Socket 接管，完全不修改飞牛官方程序、nginx 配置与数据库。在线音源只使用你扫码登录的那一个私人网易云账号的权益；未登录时自动降级为只播免费曲目，并可通过 PushPlus 推送登录失效与 VIP 临期提醒。
source                = thirdparty
platform              = all

maintainer            = gzywd
maintainer_url        = https://github.com/gzywd/fnos_music_ext
distributor           = gzywd
distributor_url       = https://github.com/gzywd/fnos_music_ext

os_min_version        = 1.1.3100

install_dep_apps      = python312

ctl_stop              = true
checkport             = false
disable_authorization_path = false
micro_app             = true

changelog             = v2.9.6：本地每日推荐缓存加 schema 版本号，旧格式（v2.9.0~v2.9.4 生成的、duration/size 全为 0 且未写本地文件索引）在下一次拉歌单列表时自动判废重建，用户无需点任何按钮；缓存命中时若索引缺失会顺手补写。附带修正 v2.9.5 说明里「点一次预热歌单缓存」的错误引导——那个按钮只服务于网易云在线歌单。 v2.9.5：修复本地每日推荐「有清单、没内容、点不开」——本地曲目 guid 是我们自己造的 local:file:<sha1>，却被原样转发给不认识它的官方后端：封面请求直接 400（整张歌单没封面）、metadata 返回空值、duration/size 恒为 0 被客户端判定不可播。本次：① 新增本地文件索引与标签探测，标题/艺术家/专辑/时长/体积/码率全部从文件里读；② 封面三级取图：音频内嵌图(FLAC picture/ID3 APIC/MP4 covr)→同目录 cover.jpg→生成的唱片占位图，并按 sha1 落盘缓存；③ metadata 自行应答，形状对齐官方（含 genres/album/artists，缺了客户端会跳过播放）；④ 播放路径反查再兜一层持久索引。⑤ 本地每日推荐排到歌单列表第一位：默认顺序改为 localdaily,daily,…，配置里没写 localdaily 时直接插到最前（写了以配置为准），setup.sh 对旧默认值做一次性迁移。⑥ 授权状态不再误报故障：未注入 TRIM_API_TOKEN 时退到应用配置的 share_paths 文件读取授权目录，读到即标记「降级但正常」，只在确实没有任何授权目录时才给指引。
desktop_uidir         = ui
desktop_applaunchname = fnmusicext.main
