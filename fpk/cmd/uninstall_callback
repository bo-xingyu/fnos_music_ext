#!/bin/bash
# uninstall_callback —— 卸载清理【之后】执行：按用户选择清理数据
#
# 此时 APPDEST 已被移除，只能使用 stage 在 $RUN_DIR 下的副本。
# 用户数据默认保留；wizard_remove_data / wizard_remove_library_cache 为 true
# 时才删除。曲库文件删除【只】依据扩展自己写的 .ref 记录逐一精确定位，
# 绝不使用通配符扫目录，避免误删用户自有音乐。
#
# 官方约定：生命周期脚本应尽量幂等；失败前把用户可见错误写入 $TRIM_TEMP_LOGFILE。
set -uo pipefail

export PATH="/var/apps/python312/target/bin:${PATH}"

APP_NAME="fnmusicext"
APPDEST="${TRIM_APPDEST:-/var/apps/${APP_NAME}/target}"
PKGVAR="${TRIM_PKGVAR:-/vol1/@appvar/${APP_NAME}}"
RUN_DIR="${PKGVAR}/app"
# 网易云登录凭证持久目录（与 fnmusic-lib.sh 中定义保持一致；本回调不 source 那个库，
# 因为卸载阶段 APPDEST 可能已被移除，只能就地定义，避免变量为空导致清理静默失效）
MUSICBOX_DATA_DIR="${PKGVAR}/musicbox-data"

# 卸载回调阶段 APPDEST 可能已被移除，回落到 stage 过的一份副本
BIN="${APPDEST}/bin"
if [ ! -f "${BIN}/fnmusic-lib.sh" ]; then
    BIN="${RUN_DIR}/bin"
fi

fail() {
    local msg="$1"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        echo "${msg}" >> "${TRIM_TEMP_LOGFILE}" 2>/dev/null
    fi
    echo "[fnmusic-ext] ${msg}" >&2
}

need() {
    local script="$1"
    if [ ! -f "${BIN}/${script}" ]; then
        fail "找不到 ${BIN}/${script}，无法完成本步骤。请重新安装本应用。"
        return 1
    fi
    return 0
}

log_file="${PKGVAR}/logs/uninstall.log"
mkdir -p "$(dirname "${log_file}")" 2>/dev/null
log() { echo "$(date '+%F %T') [uninstall_callback] $*" >> "${log_file}" 2>/dev/null; }

REMOVE_DATA="$(echo "${wizard_remove_data:-false}" | tr '[:upper:]' '[:lower:]')"
REMOVE_LIB="$(echo "${wizard_remove_library_cache:-false}" | tr '[:upper:]' '[:lower:]')"
is_true() { case "$1" in true|1|yes|on) return 0 ;; *) return 1 ;; esac; }

CACHE_DIR="${RUN_DIR}/cache"

# 1. 精确删除本扩展写入曲库的在线音频（依据 .ref 记录，不做通配匹配）
if is_true "${REMOVE_LIB}"; then
    log "按用户选择清理曲库中的在线音频缓存"
    removed=0
    missing=0
    if [ -d "${CACHE_DIR}" ]; then
        while IFS= read -r ref; do
            [ -f "${ref}" ] || continue
            stem="$(cat "${ref}" 2>/dev/null | head -n 1)"
            # 只接受绝对路径且落在曲库目录内的记录，拒绝相对路径与越权路径
            case "${stem}" in
                /*) ;;
                *) log "跳过非绝对路径记录: ${ref}"; continue ;;
            esac
            case "${stem}" in
                *..*) log "跳过可疑路径记录: ${stem}"; continue ;;
            esac
            matched=0
            for ext in mp3 flac wav ogg opus m4a aac ape wv dsf dff tta lrc fnmusic.json; do
                if [ -f "${stem}.${ext}" ]; then
                    rm -f "${stem}.${ext}" && removed=$((removed + 1)) && matched=1
                fi
            done
            [ "${matched}" -eq 0 ] && missing=$((missing + 1))
        done < <(find "${CACHE_DIR}" -maxdepth 1 -name '*.ref' -type f 2>/dev/null)
    fi
    log "曲库清理完成：删除 ${removed} 个文件，${missing} 条记录已无对应文件"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        echo "已从曲库目录移除本扩展写入的 ${removed} 个在线音频/歌词缓存文件。" >> "${TRIM_TEMP_LOGFILE}" 2>/dev/null
    fi
else
    log "保留曲库中已落盘的在线音频缓存"
fi

# 2. 运行目录与持久数据
#
# 【曾经的 bug】这里的条件尾部写了 `|| true`，使它**恒为真**：无论用户是否勾选
# 「删除数据」，RUN_DIR 都会被整个 rm -rf。而网易云登录凭证当时正住在
# ${RUN_DIR}/musicbox-data 里，于是**每次手动安装新版 fpk**（走的就是卸载+安装，
# 不是保留数据的升级）都会把 cookie 删掉，用户被迫重新扫码 —— 频繁扫码登录正是
# 网易云风控最敏感的行为之一。
#
# 现已把凭证迁到 ${PKGVAR}/musicbox-data（RUN_DIR 之外，跨安装持久），
# 并把这里改回尊重用户勾选：默认保留，只有明确勾选删除时才清理。
if is_true "${REMOVE_DATA}" || is_true "${REMOVE_LIB}"; then
    if [ -n "${RUN_DIR}" ] && [ -d "${RUN_DIR}" ]; then
        # 安全护栏：确认要删的确实是本应用的 stage 目录
        case "${RUN_DIR}" in
            */@appvar/fnmusicext/app|*/fnmusicext/app)
                log "按用户选择删除运行目录 ${RUN_DIR}（含 .env / 缓存 / 收藏）"
                rm -rf "${RUN_DIR}" 2>/dev/null || log "删除 ${RUN_DIR} 失败"
                ;;
            *)
                log "护栏拦截：RUN_DIR=${RUN_DIR} 不在预期的 @appvar/fnmusicext 路径下，拒绝删除"
                ;;
        esac
    fi
    if is_true "${REMOVE_DATA}"; then
        # 只有用户明确选择删除数据时，才连网易云登录凭证一起清理
        if [ -d "${MUSICBOX_DATA_DIR}" ]; then
            log "按用户选择删除网易云登录凭证 ${MUSICBOX_DATA_DIR}"
            rm -rf "${MUSICBOX_DATA_DIR}" 2>/dev/null || log "删除 ${MUSICBOX_DATA_DIR} 失败"
        fi
        rm -f "${PKGVAR}/.env.upgrade.bak" "${PKGVAR}/.env.preserved" 2>/dev/null
    fi
else
    log "保留运行数据（未勾选删除）"
    # 即便不删，也备份一份配置：飞牛「卸载+重装」是手动安装新版 fpk 的常见路径，
    # 重装后向导里 PushPlus token 是空的，靠这份快照恢复，免得用户重填。
    if [ -f "${RUN_DIR}/.env" ]; then
        cp -a "${RUN_DIR}/.env" "${PKGVAR}/.env.preserved" 2>/dev/null \
            && log "已快照 .env 到 ${PKGVAR}/.env.preserved（重装时恢复 token）"
    fi
fi

# 3. systemd 残留（本应用不注册 unit，但 v1.x 脚本式安装可能留过）
for unit in fnmusic-ext fnmusic-musicbox fnmusic-musicdl fnmusic-lxmusic; do
    if [ -f "/etc/systemd/system/${unit}.service" ]; then
        log "清理 v1.x 遗留 unit: ${unit}.service"
        systemctl disable --now "${unit}.service" >/dev/null 2>&1
        rm -f "/etc/systemd/system/${unit}.service" 2>/dev/null
    fi
done
systemctl daemon-reload >/dev/null 2>&1

log "=== uninstall_callback 完成 ==="
exit 0
